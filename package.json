{
  "name": "pausio",
  "description": "Private, local-first eye-break companion built with Tauri and Svelte.",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/adechristanto/PausIO.git"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "check": "pnpm --dir frontend check",
    "test": "pnpm --dir frontend test",
    "tauri": "node scripts/tauri.mjs",
    "release": "node scripts/release.mjs",
    "gen:mobile": "./scripts/generate-mobile.sh",
    "test:e2e:desktop": "cross-env VITE_E2E=1 pnpm --dir frontend build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol,e2e-webdriver && wdio run wdio.conf.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@wdio/cli": "9.31.2",
    "@wdio/globals": "9.31.1",
    "@wdio/local-runner": "9.31.4",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "cross-env": "10.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.6.0"
    }
  }
}
